[
  {
    "id": "documents",
    "name": "Documents de travail",
    "description": "Rédiger et préparer des documents dans votre espace Prophet.",
    "scopes": [
      "~/Documents/Prophet"
    ],
    "manifest": {
      "agent": {
        "id": "org.prophet.documents-locaux",
        "version": "1.0.0",
        "name": "Documents locaux",
        "publisher_key": "ed25519:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
      },
      "model": {
        "preferred": [
          "local:qwen3-1.7b",
          "local:qwen3-0.6b"
        ],
        "privacy": "local-only",
        "roles": {
          "reflect": ["local:qwen3-1.7b"],
          "execute": ["local:qwen3-0.6b", "local:qwen3-1.7b"]
        }
      },
      "sandbox": {
        "min_level": 0
      },
      "capabilities": {
        "max": {
          "fs.read": [
            "~/Documents/Prophet/**"
          ],
          "fs.list": [
            "~/Documents/Prophet/**"
          ],
          "fs.write": [
            "~/Documents/Prophet/**"
          ],
          "tool.call": [
            "task.status",
            "task.diff",
            "fs.read",
            "doc.read",
            "fs.list",
            "fs.stat",
            "fs.search",
            "fs.write",
            "fs.edit"
          ]
        }
      },
      "budget": {
        "default": {
          "tokens": 20000,
          "wall_time": "120s",
          "approvals": 3
        }
      }
    }
  },
  {
    "id": "web",
    "name": "Recherche sur le web",
    "description": "Consulter le web par le navigateur de Prophet et déposer des notes dans votre espace. Chaque sortie passe par egress et figure au journal ; un envoi de formulaire attend votre accord.",
    "scopes": [
      "~/Documents/Prophet"
    ],
    "manifest": {
      "agent": {
        "id": "org.prophet.web-local",
        "version": "1.0.0",
        "name": "Recherche web locale",
        "publisher_key": "ed25519:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
      },
      "model": {
        "preferred": [
          "local:qwen3-1.7b",
          "local:qwen3-0.6b"
        ],
        "privacy": "local-only",
        "roles": {
          "reflect": ["local:qwen3-1.7b"],
          "execute": ["local:qwen3-0.6b", "local:qwen3-1.7b"]
        }
      },
      "sandbox": {
        "min_level": 0
      },
      "capabilities": {
        "max": {
          "fs.read": [
            "~/Documents/Prophet/**"
          ],
          "fs.list": [
            "~/Documents/Prophet/**"
          ],
          "fs.write": [
            "~/Documents/Prophet/**"
          ],
          "net.egress": [
            "*"
          ],
          "ui.read": [
            "browser"
          ],
          "ui.act": [
            "browser"
          ],
          "tool.call": [
            "task.status",
            "task.diff",
            "fs.read",
            "doc.read",
            "fs.list",
            "fs.stat",
            "fs.search",
            "fs.write",
            "fs.edit",
            "http.fetch",
            "web.open",
            "web.tree",
            "web.act",
            "task.delegate"
          ],
          "task.spawn": [
            "documents"
          ]
        }
      },
      "budget": {
        "default": {
          "tokens": 30000,
          "wall_time": "180s",
          "approvals": 3
        }
      }
    }
  },
  {
    "id": "bureau",
    "name": "Éditeur du bureau",
    "description": "Travailler dans les applications ouvertes sur le bureau (éditeur, LibreOffice, GIMP, Inkscape, FreeCAD, lecteur PDF) et déposer des fichiers dans votre espace. L'agent lit et manipule l'application par son arbre d'accessibilité, sans capture d'écran ; chaque action figure au journal.",
    "scopes": [
      "~/Documents/Prophet"
    ],
    "manifest": {
      "agent": {
        "id": "org.prophet.bureau-local",
        "version": "1.0.0",
        "name": "Éditeur du bureau",
        "publisher_key": "ed25519:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
      },
      "model": {
        "preferred": [
          "local:qwen3-0.6b"
        ],
        "privacy": "local-only"
      },
      "sandbox": {
        "min_level": 0
      },
      "capabilities": {
        "max": {
          "fs.read": [
            "~/Documents/Prophet/**"
          ],
          "fs.list": [
            "~/Documents/Prophet/**"
          ],
          "fs.write": [
            "~/Documents/Prophet/**"
          ],
          "ui.read": [
            "mousepad",
            "soffice",
            "gimp",
            "inkscape",
            "freecad",
            "evince"
          ],
          "ui.act": [
            "mousepad",
            "soffice",
            "gimp",
            "inkscape",
            "freecad",
            "evince"
          ],
          "tool.call": [
            "task.status",
            "task.diff",
            "fs.read",
            "doc.read",
            "fs.list",
            "fs.stat",
            "fs.search",
            "fs.write",
            "fs.edit",
            "ui.apps",
            "ui.tree",
            "ui.act"
          ]
        }
      },
      "budget": {
        "default": {
          "tokens": 30000,
          "wall_time": "180s",
          "approvals": 3
        }
      }
    }
  }
]
